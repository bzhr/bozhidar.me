---
import Layout from "../layouts/Layout.astro";
import PostPreview from "../components/PostPreview.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Bozhidar Hristov | Fullstack Developer & Tech Lead"
  description="Bozhidar Hristov is a Fullstack Developer and Tech Lead building software across backend, frontend, data and AI, alongside a personal blog."
  keywords={[
    "Bozhidar Hristov",
    "Bozhidar",
    "personal blog",
    "software development",
    "technology",
    "endurance training",
  ]}
>
  <section class="intro">
    <h1>Hi, I'm Bozhidar 👋</h1>
    <p>
      I'm a Fullstack Developer and currently a Tech Lead at HeartStamp. My work spans backend, frontend, data and AI. This is my corner of the internet, where I share thoughts on software development, technology, endurance training and other things that interest me. Find my <a href="/cv">CV</a> or learn more <a href="/about">about me</a>.
    </p>
  </section>

  <section>
    <h2>Latest Posts</h2>
    {
      posts.map((post) => (
        <PostPreview
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          url={`/blog/${post.id}`}
        />
      ))
    }
    <div class="view-all">
      <a href="/blog">View all posts →</a>
    </div>
  </section>
</Layout>

<style>
  .intro {
    margin: 0 0 2rem;
  }
  .intro-logo {
    display: block;
    width: 96px;
    height: auto;
    margin: 0 0 1rem 0;
  }
  h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
  }
  .view-all {
    margin-top: 2rem;
  }
</style>

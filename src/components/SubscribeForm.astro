---
// Public form action from Brevo's Simple HTML embed.
const signupAction = 'https://1937dc61.sibforms.com/serve/MUIFAEj0Hmhym0gFSDAQHnBesxzvfyReXSfJn4fQ-8rr0wC0bTY7tmLvKaaUFaisTo-ibJ2vFQcdG7rxpqcxXiB0s4C5AxBjF1ARIwLdHnt9BrkdayUlEZZGNttyRhjuYaZQsr8XVylB2s0iD3BSEbgxfga4BKw9CLFS5a4xe02m-muIqpJusv8vg23KgHOFqNwHsaNC9Op_i_9p';
---

<section class="newsletter" aria-labelledby="newsletter-heading">
  <h2 id="newsletter-heading">Get new posts by email</h2>
  <form action={signupAction} method="post" data-newsletter-form hidden>
    <label for="newsletter-email">Email address</label>
    <div class="newsletter-fields">
      <input
        id="newsletter-email"
        type="email"
        name="EMAIL"
        autocomplete="email"
        aria-describedby="newsletter-help"
        required
      />
      <button type="submit">Subscribe</button>
    </div>
    <div hidden>
      <input type="text" name="email_address_check" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="locale" value="en" />
    <input type="hidden" name="html_type" value="simple" />
    <p id="newsletter-help">Confirm by email. Unsubscribe anytime.</p>
    <p role="status" data-newsletter-status></p>
  </form>
  <p data-newsletter-fallback><a href={signupAction}>Subscribe to new posts</a></p>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const fallback = document.querySelector<HTMLElement>('[data-newsletter-fallback]');
  const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');
  const button = form?.querySelector('button');

  if (form && fallback && status && button) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = new URLSearchParams();
      for (const [name, value] of new FormData(form)) {
        if (typeof value === 'string') body.append(name, value);
      }

      button.disabled = true;
      status.textContent = 'Submitting…';

      try {
        const response = await fetch(form.action, { method: 'POST', body });
        const result = await response.json();

        if (response.ok && result.success === true) {
          status.textContent = 'Check your inbox for a link to confirm your subscription.';
          form.reset();
        } else {
          status.textContent = 'Couldn’t save your signup. Please try again.';
        }
      } catch {
        status.textContent = 'Couldn’t verify your signup. Check your inbox or use the signup page below.';
        fallback.hidden = false;
      } finally {
        button.disabled = false;
      }
    });
    form.hidden = false;
    fallback.hidden = true;
  }
</script>

<style>
  .newsletter {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }

  .newsletter-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 27rem;
  }

  input[type='email'], button {
    box-sizing: border-box;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid;
    border-radius: 0.5rem;
    font: inherit;
  }

  input[type='email'] {
    flex: 1 1 13rem;
    min-width: 0;
    border-color: var(--text-secondary);
    background: var(--background);
    color: var(--text-primary);
  }

  button {
    border-color: currentColor;
    background: var(--background);
    color: var(--link-color);
    cursor: pointer;
  }

  button:hover {
    background: var(--code-bg);
    color: var(--link-hover-color);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  :is(input, button):focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  #newsletter-help, [data-newsletter-status], [data-newsletter-fallback] {
    margin: 0.5rem 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  [data-newsletter-status]:empty {
    margin: 0;
  }
</style>

---
interface Props {
	title: string;
	description: string;
	pubDate: Date;
	url: string;
}

const { title, description, pubDate, url } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric'
});
---

<article class="post-preview">
	<header>
		<time datetime={pubDate.toISOString()}>{formattedDate}</time>
		<h2><a href={url}>{title}</a></h2>
	</header>
	<p>{description}</p>
	<a href={url} class="read-more">Read more →</a>
</article>

<style>
	.post-preview {
		margin: 0 0 1.75rem;
	}
	.post-preview header {
		margin: 0;
	}
	time {
		display: block;
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.3;
	}
	h2 {
		margin: 0.25rem 0 0.5rem;
	}
	.post-preview > p { margin: 0 0 0.5rem; }
	.read-more { display: inline-block; margin-top: 0.25rem; }
	h2 a {
		color: var(--text-primary);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--accent);
	}
	@media (max-width: 520px) {
		.post-preview { margin-bottom: 1.5rem; }
		h2 { font-size: 1.375rem; }
	}
</style>
